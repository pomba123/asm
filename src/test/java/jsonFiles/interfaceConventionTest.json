{
  "conventions": [
  {
      "name": "ImplementsInterfaceConvention",
      "conventionScope": "class",
      "allRulesMustApply": "false",
      "rules": [
        {
          "implementation": "org.example.verifiers.ClassImplementsInterfaceConventionVerifier",
          "parameters": [
            { "name": "interface", "type": "String", "value": "TestInterface"
            }
          ]
        }],
      "annotation": {
        "name": "annotations.AnnotationWithParametersForClass",
        "parameters": [
          {"name": "value", "value": "3", "type": "int"},
          {"name": "name", "value": "Test", "type": "String"}
        ]
      }
    }]
}
