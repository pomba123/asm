{
  "conventions": [
    {
      "name": "SuffixConvention",
      "conventionScope": "method",
      "allRulesMustApply": "false",
      "rules": [
        {
          "implementation": "org.example.verifiers.SuffixConventionVerifier",
          "parameters": [
            { "name": "suffix", "value": "set" }
          ]
        }],
      "annotation": {
        "name": "org.example.annotations.AnnotationWithParameters",
        "parameters": [
          {"name": "name", "value": "hello"},
          {"name": "value", "value": 3}
        ]
      }
   }]
}
